# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://mastad.se,https://www.mastad.se

# ---------------------------------------------------------------------------
# Database (MySQL on Hostinger, created in hPanel -> Databases)
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://root:password@localhost:3306/ma_stad"

# ---------------------------------------------------------------------------
# Auth (admin dashboard). Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------------------------------------------------------------------------
# Mail (Hostinger / Titan SMTP)
# ---------------------------------------------------------------------------
# Local development: run a mail catcher and leave user and pass empty
#   docker run -d --name ma-stad-mail -p 1025:1025 -p 8025:8025 axllent/mailpit
#   SMTP_HOST=localhost  SMTP_PORT=1025  SMTP_SECURE=false
# Leaving SMTP_HOST empty prints messages to the console instead of sending.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@mastad.se
SMTP_PASS=change-me
MAIL_FROM="MA Stad <info@mastad.se>"
MAIL_TO_INTERNAL=info@mastad.se

# ---------------------------------------------------------------------------
# Business settings (overridable per row in the settings table)
# ---------------------------------------------------------------------------
RUT_PERCENTAGE=50
RUT_ANNUAL_CAP=75000
VAT_PERCENTAGE=25
PUBLIC_SITE_URL=https://mastad.se
